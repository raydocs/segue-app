<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.segue.release</string>
	<key>ProgramArguments</key>
	<array>
		<string>/Library/PrivilegedHelperTools/segue-release</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<true/>
	<key>StandardOutPath</key>
	<string>/var/log/segue-release.out</string>
	<key>StandardErrorPath</key>
	<string>/var/log/segue-release.err</string>
</dict>
</plist>
